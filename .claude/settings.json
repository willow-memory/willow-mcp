{
  "enabledMcpjsonServers": ["willow-mcp"],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      },
      {
        "matcher": "task_submit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch|willow_web_search|willow_web_fetch|willow_institutional_search|mcp__.*__willow_web_search|mcp__.*__willow_web_fetch|mcp__.*__willow_institutional_search",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-issue-closure-check.sh\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/home/sean-campbell/sean-data-vault/willow-operator-box/venvs/willow-mcp/bin/python3 -m willow_mcp.hook_runner --format claude stop_lint"
          }
        ]
      }
    ]
  }
}
