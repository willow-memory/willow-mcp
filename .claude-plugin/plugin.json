{
  "name": "willow-mcp",
  "description": "Willow sovereign agent platform — SQLite store, Postgres knowledge base, Kart task queue, plus the hooks and skills that keep them used correctly.",
  "version": "2.79.0",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m willow_mcp.hook_runner --format claude session_start"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m willow_mcp.hook_runner --format claude session_stop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      },
      {
        "matcher": "task_submit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch|willow_web_search|willow_web_fetch|willow_institutional_search|mcp__.*__willow_web_search|mcp__.*__willow_web_fetch|mcp__.*__willow_institutional_search",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m willow_mcp.hook_runner --format claude stop_lint"
          }
        ]
      }
    ]
  },
  "skills": [
    "skills/session-start.md",
    "skills/consent.md",
    "skills/worktree.md",
    "skills/handoff-write.md",
    "skills/external-guard.md",
    "skills/schema-confirm.md",
    "skills/willow-serve.md",
    "skills/kart-tasks.md",
    "skills/debugging.md",
    "skills/review.md",
    "skills/tdd.md",
    "skills/brainstorming.md",
    "skills/persona-overlays.md",
    "skills/forks.md",
    "skills/frank.md",
    "skills/gaps.md",
    "skills/human-required.md",
    "skills/knowledge-curate.md"
  ]
}
