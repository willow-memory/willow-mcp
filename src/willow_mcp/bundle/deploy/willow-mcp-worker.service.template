# systemd --user template for a standalone willow-mcp/Kartikeya worker.
# unit: willow-mcp-worker-@LANE@.service
[Unit]
Description=willow-mcp Kart worker (@LANE@ lane)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@WORKDIR@
Environment="WILLOW_HOME=@WILLOW_HOME@"
Environment="WILLOW_STORE_ROOT=@WILLOW_STORE_ROOT@"
Environment="WILLOW_PG_DB=@WILLOW_PG_DB@"
Environment="WILLOW_PG_USER=@WILLOW_PG_USER@"
Environment="WILLOW_APP_ID=@APP_ID@"
Environment="WILLOW_WORKER_LANE=@LANE@"
Environment="WILLOW_WORKER_HEARTBEAT_ROOT=@HEARTBEAT_ROOT@"
# The work root, explicit and not inferred. Unset, willow_repo_root() falls
# through to the installed package tree, which on an editable install is the
# repo's src/ directory, and the read-only work-root sandbox then covers src/
# only: pyproject.toml, .git and .venv stay writable from tasks (measured from
# inside a task 2026-09-02).
Environment="WILLOW_ROOT=@WORKDIR@"
# The egress verifier runs in this worker, so strict trust root has to be set
# here, not only in an MCP client config. The brokered install carries the value
# forward from the unit it replaces and refuses (EDOWNGRADE) to turn it off.
Environment="WILLOW_MCP_STRICT_TRUST_ROOT=@STRICT_TRUST_ROOT@"
# Kart sandbox seams. These MUST be literal Environment= lines, not an
# EnvironmentFile: the seams were added to $WILLOW_HOME/env on 2026-07-22 and
# did not cure the fault, because a running process's environment cannot be
# changed by editing a file it read at exec time (or, here, never read at all).
# Without KART_SANDBOX_CONFIG, kartikeya resolves its vendored product-neutral
# default and every task fails `bwrap: Creating new namespace failed`.
Environment="KART_SANDBOX_CONFIG=@KART_SANDBOX_CONFIG@"
# Inference-provider keys for allow_net tasks, and nothing else (Nestor pair
# b1e88cda, amends f07789d1). env.kart is the operator-maintained subset of
# $WILLOW_HOME/env. The full env is never loaded here: it also holds
# NESTOR_SEAL_KEY, and a seal key must not sit in the process that launches
# agent tasks. The leading '-' lets a box with no env.kart start with no
# provider keys. This file is read at exec, so a key change takes a worker
# restart; the seams above stay literal Environment= lines for that reason.
EnvironmentFile=-@WILLOW_HOME@/env.kart
ExecStart=@PYTHON@ -m willow_mcp.worker --lane @LANE@ --app-id @APP_ID@ --require-postgres
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
