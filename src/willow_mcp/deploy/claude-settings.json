{
  "enableAllProjectMcpServers": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.hook_runner --format claude session_start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      },
      {
        "matcher": "task_submit",
        "hooks": [
          {
            "type": "command",
            "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch|willow_web_search|willow_web_fetch|willow_institutional_search|mcp__.*__willow_web_search|mcp__.*__willow_web_fetch|mcp__.*__willow_institutional_search",
        "hooks": [
          {
            "type": "command",
            "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.hook_runner --format claude pre_tool"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.hook_runner --format claude session_stop"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.hook_runner --format claude stop_lint"
          }
        ]
      }
    ]
  }
}
