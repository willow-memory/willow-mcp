{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.session_start_hook",
        "timeout": 15,
        "failClosed": false
      }
    ],
    "preToolUse": [
      {
        "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.pre_tool_hook",
        "matcher": "Shell",
        "timeout": 5,
        "failClosed": true
      },
      {
        "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.pre_tool_hook",
        "matcher": "MCP:.*",
        "timeout": 5,
        "failClosed": true
      },
      {
        "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.pre_tool_hook",
        "matcher": "Write",
        "timeout": 5,
        "failClosed": true
      },
      {
        "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.pre_tool_hook",
        "matcher": "WebSearch|WebFetch",
        "timeout": 5,
        "failClosed": true
      },
      {
        "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.pre_tool_hook",
        "matcher": "Task",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "beforeShellExecution": [
      {
        "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.pre_tool_hook",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "beforeMCPExecution": [
      {
        "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.pre_tool_hook",
        "timeout": 5,
        "failClosed": true
      }
    ],
    "sessionEnd": [
      {
        "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.session_stop_hook",
        "timeout": 120,
        "failClosed": false
      }
    ],
    "stop": [
      {
        "command": "{{WILLOW_MCP_PYTHON}} -m willow_mcp.stop_lint_hook",
        "timeout": 30,
        "failClosed": false
      }
    ]
  }
}
