# unit: willow-mcp-serve.service.d/keyring.conf
#
# Tracked drop-in for the installed willow-mcp-serve.service (assignment
# 16BAEFD8): adds WILLOW_KEYRING to the served broker's environment so a
# sealed amendment (row 18, pair c6f65c11) or any other seal verification in
# serve mode is not refused "no keyring configured". Installed beside the
# other drop-ins in willow-mcp-serve.service.d/ (override.conf,
# port-8768.conf, vault-home.conf) via unit_install_execute (verb 17),
# never written by hand.
#
# @WILLOW_KEYRING@ is resolved the SAME way the reloader's own rendered unit
# resolves it (reloader.resolve_keyring_path): read from the net-signer
# unit's own environment first, net_signer.default_ring_path() as the named
# fallback -- never this process's own possibly-unset WILLOW_KEYRING.
[Service]
Environment="WILLOW_KEYRING=@WILLOW_KEYRING@"
